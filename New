UpdateInventory.OnClientEvent:Connect(function(category, items)
    if category ~= "Items" then return end
    if Loaded then return end
    Loaded = true
    for i, item in ipairs(items or {}) do
        local Rarity = RarityConfig:GetRarity(item.name) or "Gamepass"
        local Rank = RarityRank[Rarity] or 0
        if Rank >= minrarity then
            Inventory[#Inventory + 1] = {
                name = item.name,
                quantity = item.quantity or 1,
                rarity = Rarity,
                rank = Rank,
            }
        end
    end
    table.sort(Inventory, function(a, b)
        if a.rank ~= b.rank then return a.rank > b.rank end
        return a.quantity > b.quantity
    end)
    Done = true
end)

